{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Expectation Design Interaction Contracts",
  "type": "object",
  "required": ["schema_version", "artifact_type", "interaction_contracts"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "schema": { "type": "string" },
    "artifact_type": { "type": "string", "const": "interaction-contracts" },
    "interaction_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "related_expectations", "given", "when", "then"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "related_expectations": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "given": { "type": "object" },
          "when": { "type": "object" },
          "then": { "type": "object" },
          "must_not": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

