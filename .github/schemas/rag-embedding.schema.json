{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAG Embedding",
  "type": "object",
  "required": [
    "schema_version",
    "embedding_id",
    "chunk_id",
    "document_id",
    "source_path",
    "embedding_model",
    "dimensions",
    "embedding",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "examples": ["1.0"]
    },
    "embedding_id": { "type": "string" },
    "chunk_id": { "type": "string" },
    "document_id": { "type": "string" },
    "source_path": { "type": "string" },
    "chunk_path": { "type": "string" },
    "embedding_model": {
      "type": "string",
      "examples": ["local-hash-embedding-v1"]
    },
    "dimensions": {
      "type": "integer",
      "minimum": 1
    },
    "embedding": {
      "type": "object",
      "description": "Sparse vector represented as dimension index to normalized value.",
      "additionalProperties": {
        "type": "number"
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "document_type": { "type": "string" },
        "title": { "type": "string" },
        "project": { "type": "string" },
        "repository": { "type": "string" },
        "branch": { "type": "string" },
        "commit": { "type": "string" },
        "status": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
