{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAG Retrieval Result",
  "type": "object",
  "required": [
    "schema_version",
    "query",
    "created_at",
    "index_path",
    "candidate_count",
    "selected_chunks",
    "dropped_chunks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "examples": ["1.0"]
    },
    "query": { "type": "string" },
    "created_at": { "type": "string" },
    "index_path": { "type": "string" },
    "filters": {
      "type": "object",
      "properties": {
        "project": { "type": "string" },
        "repository": { "type": "string" },
        "branch": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "candidate_count": { "type": "integer", "minimum": 0 },
    "selected_chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chunk_id", "document_id", "score", "source_path", "chunk_path"],
        "properties": {
          "chunk_id": { "type": "string" },
          "document_id": { "type": "string" },
          "score": { "type": "number" },
          "source_path": { "type": "string" },
          "chunk_path": { "type": "string" },
          "heading_path": {
            "type": "array",
            "items": { "type": "string" }
          },
          "reason": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "dropped_chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chunk_id", "reason"],
        "properties": {
          "chunk_id": { "type": "string" },
          "score": { "type": "number" },
          "reason": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
