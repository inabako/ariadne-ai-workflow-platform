{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAG Chunk",
  "type": "object",
  "required": [
    "schema_version",
    "chunk_id",
    "document_id",
    "source_path",
    "chunk_index",
    "content",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "examples": ["1.0"]
    },
    "chunk_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "source_path": {
      "type": "string"
    },
    "normalized_path": {
      "type": "string"
    },
    "chunk_index": {
      "type": "integer",
      "minimum": 0
    },
    "heading_path": {
      "type": "array",
      "items": { "type": "string" }
    },
    "content": {
      "type": "string"
    },
    "char_start": {
      "type": "integer",
      "minimum": 0
    },
    "char_end": {
      "type": "integer",
      "minimum": 0
    },
    "metadata": {
      "type": "object",
      "required": ["document_type", "project", "repository", "branch", "commit", "tags"],
      "properties": {
        "document_type": { "type": "string" },
        "title": { "type": "string" },
        "project": { "type": "string" },
        "repository": { "type": "string" },
        "branch": { "type": "string" },
        "commit": { "type": "string" },
        "workflow": { "type": "string" },
        "phase": { "type": "string" },
        "status": { "type": "string" },
        "severity_focus": {
          "type": "array",
          "items": { "type": "string" }
        },
        "areas": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "artifact_type": { "type": "string" },
        "source_type": { "type": "string", "examples": ["internal-work", "external-web"] },
        "source_kind": { "type": "string" },
        "source_owner": { "type": "string" },
        "category": { "type": "string" },
        "topic": { "type": "string" },
        "trust_level": { "type": "string" },
        "retrieved_at": { "type": "string" },
        "freshness_policy": { "type": "string" },
        "verify_before_use": { "type": "boolean" },
        "sources": {
          "type": "array",
          "items": { "type": "string" }
        },
        "urls": {
          "type": "array",
          "items": { "type": "string" }
        },
        "claims": {
          "type": "array",
          "items": { "type": "string" }
        },
        "verification_notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "front_matter": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
