{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ariadne Review Council Finding Draft",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "status",
    "review_id",
    "work_id",
    "reviewer",
    "source_report",
    "draft_count",
    "drafts"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "artifact_type": { "const": "review-council-finding-draft" },
    "status": { "const": "drafted" },
    "review_id": { "type": "string" },
    "work_id": { "type": "string" },
    "reviewer": { "type": "string" },
    "source_report": { "type": "string" },
    "draft_count": { "type": "integer" },
    "created_at": { "type": "string" },
    "artifacts": { "type": "object" },
    "drafts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "draft_id",
          "reviewer",
          "category",
          "severity",
          "claim",
          "verdict",
          "blocking",
          "status",
          "registration_command"
        ],
        "properties": {
          "draft_id": { "type": "string" },
          "reviewer": { "type": "string" },
          "category": { "type": "string" },
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "claim": { "type": "string" },
          "verdict": { "enum": ["pass", "warn", "fail", "unsupported", "needs-qa", "changes-required"] },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "counterexample": { "type": "string" },
          "reasoning_summary": { "type": "string" },
          "requested_action": { "type": "string" },
          "confidence": { "type": "number" },
          "required_tests": { "type": "array", "items": { "type": "string" } },
          "blocking": { "type": "boolean" },
          "status": { "type": "string" },
          "registration_command": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
