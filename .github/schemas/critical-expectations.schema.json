{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Critical Expectations",
  "type": "object",
  "required": ["schema_version", "artifact_type", "critical_expectations"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "schema": { "type": "string" },
    "artifact_type": { "type": "string", "const": "critical-expectations" },
    "critical_expectations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["expectation_id", "minimum_probability", "failure_action", "reason"],
        "properties": {
          "expectation_id": { "type": "string", "minLength": 1 },
          "minimum_probability": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "failure_action": {
            "type": "string",
            "enum": ["reject-candidate", "human-review-required", "mark-constraint", "request-regeneration"]
          },
          "reason": { "type": "string", "minLength": 1 },
          "human_override_allowed": { "type": "boolean" },
          "approved_by": { "type": "string" },
          "approved_at": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

