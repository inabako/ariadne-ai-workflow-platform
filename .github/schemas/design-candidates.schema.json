{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Candidates",
  "type": "object",
  "required": ["schema_version", "artifact_type", "candidates"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "schema": { "type": "string" },
    "artifact_type": { "type": "string", "const": "design-candidates" },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string" }
    },
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "concept", "status"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "concept": { "type": "string" },
        "target_users": { "$ref": "#/$defs/stringList" },
        "main_flow": { "$ref": "#/$defs/stringList" },
        "primary_expectations": { "$ref": "#/$defs/stringList" },
        "emotional_priority": { "$ref": "#/$defs/stringList" },
        "technical_notes": { "$ref": "#/$defs/stringList" },
        "implementation_cost_notes": { "$ref": "#/$defs/stringList" },
        "known_risks": { "$ref": "#/$defs/stringList" },
        "status": { "type": "string", "enum": ["draft", "constrained", "feasible", "selected", "rejected"] }
      },
      "additionalProperties": false
    }
  }
}
