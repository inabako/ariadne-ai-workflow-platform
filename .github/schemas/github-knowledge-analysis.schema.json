{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub Knowledge Analysis",
  "type": "object",
  "required": [
    "schema_version",
    "workflow",
    "work_id",
    "repository",
    "scan_mode",
    "repair_mode",
    "rag_output",
    "generated_at",
    "summary",
    "collection_plan",
    "knowledge_assets",
    "narrative_gaps",
    "repair_proposals",
    "github_sync_actions",
    "knowledge_db_candidates",
    "rag_candidates"
  ],
  "properties": {
    "schema_version": { "type": "string", "examples": ["1.0"] },
    "workflow": { "type": "string", "const": "github-knowledge-maintenance" },
    "work_id": { "type": "string" },
    "repository": { "type": "string" },
    "target_branch": { "type": "string" },
    "scan_mode": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["repository", "issue", "pull-request", "recent", "full"]
      }
    },
    "repair_mode": {
      "type": "string",
      "enum": ["proposal", "apply"]
    },
    "rag_output": { "type": "boolean" },
    "generated_at": { "type": "string" },
    "summary": { "type": "string" },
    "collection_plan": {
      "type": "array",
      "items": { "$ref": "#/$defs/collection_item" }
    },
    "metadata_sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/metadata_source" }
    },
    "knowledge_assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/knowledge_asset" }
    },
    "narrative_gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/narrative_gap" }
    },
    "repair_proposals": {
      "type": "array",
      "items": { "$ref": "#/$defs/repair_proposal" }
    },
    "github_sync_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/github_sync_action" }
    },
    "knowledge_db_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/knowledge_db_candidate" }
    },
    "rag_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/rag_candidate" }
    },
    "open_questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/open_question" }
    },
    "guardrails": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "collection_item": {
      "type": "object",
      "required": ["id", "source_type", "purpose", "status"],
      "properties": {
        "id": { "type": "string" },
        "source_type": {
          "type": "string",
          "enum": ["repository", "issue", "pull-request", "comment", "label", "branch", "tag", "release", "api"]
        },
        "command": { "type": "string" },
        "purpose": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["planned", "collected", "skipped", "blocked"]
        },
        "output_ref": { "type": "string" }
      }
    },
    "metadata_source": {
      "type": "object",
      "required": ["id", "source_type", "source_ref", "collected_by"],
      "properties": {
        "id": { "type": "string" },
        "source_type": { "type": "string" },
        "source_ref": { "type": "string" },
        "collected_by": { "type": "string" },
        "collected_at": { "type": "string" },
        "evidence_path": { "type": "string" }
      }
    },
    "knowledge_asset": {
      "type": "object",
      "required": ["id", "asset_type", "source_ref", "intent", "reuse_value"],
      "properties": {
        "id": { "type": "string" },
        "asset_type": {
          "type": "string",
          "enum": ["intent", "scope", "design-decision", "corrective-action", "maintenance-knowledge", "shared-artifact", "future-rag-candidate"]
        },
        "source_ref": { "type": "string" },
        "intent": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reuse_value": { "type": "string" },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        }
      }
    },
    "narrative_gap": {
      "type": "object",
      "required": ["id", "asset_ref", "gap_type", "severity", "why_it_matters"],
      "properties": {
        "id": { "type": "string" },
        "asset_ref": { "type": "string" },
        "gap_type": {
          "type": "string",
          "enum": ["intent-gap", "scope-gap", "decision-gap", "impact-gap", "maintenance-gap", "rag-value-gap", "evidence-gap"]
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"]
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "why_it_matters": { "type": "string" },
        "blocks_repair": { "type": "boolean" }
      }
    },
    "repair_proposal": {
      "type": "object",
      "required": ["id", "target", "proposal_type", "reason", "approval_required"],
      "properties": {
        "id": { "type": "string" },
        "target": { "type": "string" },
        "proposal_type": {
          "type": "string",
          "enum": ["issue-supplement", "pr-supplement", "car-supplement", "readme-supplement", "docs-supplement", "adr-supplement"]
        },
        "reason": { "type": "string" },
        "before_summary": { "type": "string" },
        "after_summary": { "type": "string" },
        "draft_body": { "type": "string" },
        "approval_required": { "type": "boolean" }
      }
    },
    "github_sync_action": {
      "type": "object",
      "required": ["id", "target_type", "target_id", "operation", "approval_status"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "target_type": {
          "type": "string",
          "enum": ["issue", "pull-request", "issue-comment", "pr-comment", "repository-doc", "api"]
        },
        "target_id": { "type": "string" },
        "operation": {
          "type": "string",
          "enum": ["edit", "comment", "api", "generate-file"]
        },
        "reason": { "type": "string" },
        "draft_command": { "type": "string" },
        "approval_status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        }
      }
    },
    "knowledge_db_candidate": {
      "type": "object",
      "required": ["id", "candidate_type", "source_ref", "knowledge_value"],
      "properties": {
        "id": { "type": "string" },
        "candidate_type": { "type": "string" },
        "source_ref": { "type": "string" },
        "knowledge_value": { "type": "string" },
        "storage_recommendation": { "type": "string" },
        "requires_human_approval": { "type": "boolean" }
      }
    },
    "rag_candidate": {
      "type": "object",
      "required": ["id", "candidate_type", "source_ref", "knowledge_value"],
      "properties": {
        "id": { "type": "string" },
        "candidate_type": { "type": "string" },
        "source_ref": { "type": "string" },
        "knowledge_value": { "type": "string" },
        "limits": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["candidate", "approved", "rejected"]
        }
      }
    },
    "open_question": {
      "type": "object",
      "required": ["id", "question", "blocks"],
      "properties": {
        "id": { "type": "string" },
        "question": { "type": "string" },
        "reason": { "type": "string" },
        "blocks": { "type": "boolean" }
      }
    }
  }
}
