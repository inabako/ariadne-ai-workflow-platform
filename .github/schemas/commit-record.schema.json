{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commit Record",
  "type": "object",
  "required": ["schema_version", "work_id", "source_dir", "branch", "message"],
  "properties": {
    "schema_version": { "type": "string", "examples": ["1.0"] },
    "work_id": { "type": "string" },
    "source_dir": { "type": "string" },
    "branch": { "type": "string" },
    "commit": { "type": "string" },
    "message": { "type": "string" },
    "status_before": { "type": "string" },
    "created_at": { "type": "string" },
    "dry_run": { "type": "boolean" }
  }
}

