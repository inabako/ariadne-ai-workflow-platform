{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context First Tool Selection",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "architecture",
    "selected_at",
    "selected_by",
    "selection_mode",
    "work_id",
    "workflow",
    "status",
    "tools",
    "human_check_required",
    "human_check_reasons",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifact_type": {
      "const": "tool-selection"
    },
    "architecture": {
      "const": "context-first"
    },
    "selected_at": {
      "type": "string"
    },
    "selected_by": {
      "enum": [
        "dispatcher",
        "human"
      ]
    },
    "selection_mode": {
      "enum": [
        "manual",
        "auto",
        "human-check"
      ]
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "selected",
        "human-check-required",
        "skipped"
      ]
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "mode",
          "purpose",
          "required",
          "source",
          "human_check_required"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "read-only",
              "mutation",
              "local",
              "generated"
            ]
          },
          "purpose": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "source": {
            "type": "string"
          },
          "human_check_required": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "human_check_required": {
      "type": "boolean"
    },
    "human_check_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "registry",
        "schema"
      ],
      "properties": {
        "registry": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
