{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Expectation Design Dispatch",
  "type": "object",
  "required": ["schema_version", "artifact_type", "status", "dispatcher_context", "reviewers"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "schema": { "type": "string" },
    "artifact_type": { "type": "string", "const": "expectation-design-dispatch" },
    "status": { "type": "string" },
    "work_id": { "type": "string" },
    "dispatcher_context": { "type": "object" },
    "reviewers": { "type": "array", "items": { "type": "string" } },
    "review_id": { "type": "string" },
    "review_packet": { "type": "object" },
    "review_start_command": { "type": "string" },
    "returns_to_human_gate": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
