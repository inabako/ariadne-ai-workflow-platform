{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Expectation Evaluation",
  "type": "object",
  "required": ["schema_version", "artifact_type"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "schema": { "type": "string" },
    "artifact_type": {
      "type": "string",
      "enum": [
        "expectation-evaluation-input",
        "expectation-design-evaluation",
        "expectation-design-comparison",
        "expectation-violations"
      ]
    },
    "status": { "type": "string" },
    "evaluated_at": { "type": "string" },
    "work_id": { "type": "string" },
    "expectation_count": { "type": "integer", "minimum": 0 },
    "candidate_count": { "type": "integer", "minimum": 0 },
    "candidate_evaluations": {
      "oneOf": [
        {
          "type": "array",
          "items": { "$ref": "#/$defs/candidateEvaluation" }
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/evaluationResultItem" }
          }
        }
      ]
    },
    "weights": {
      "type": "array",
      "items": { "type": "object" }
    },
    "candidate_scores": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidateScore" }
    },
    "violations": {
      "type": "array",
      "items": { "$ref": "#/$defs/violation" }
    },
    "violation_summary": {
      "type": "array",
      "items": { "$ref": "#/$defs/violationSummary" }
    },
    "tradeoffs": {
      "type": "array",
      "items": { "$ref": "#/$defs/tradeOff" }
    },
    "comparison_report": {
      "type": "object"
    },
    "output": { "type": "string" },
    "violations_output": { "type": "string" },
    "tradeoffs_output": { "type": "string" },
    "comparison_json": { "type": "string" },
    "report": { "type": "string" }
  },
  "additionalProperties": true,
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "expectationEvaluation": {
      "type": "object",
      "required": ["expectation_id", "probability", "confidence"],
      "properties": {
        "expectation_id": { "type": "string", "minLength": 1 },
        "probability": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "evidence": { "$ref": "#/$defs/stringList" },
        "evidence_refs": { "$ref": "#/$defs/stringList" },
        "evidence_quality": {
          "type": "string",
          "enum": ["provided", "assumption", "human-review", "user-test", "runtime-log"]
        },
        "requires_validation": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "candidateEvaluation": {
      "type": "object",
      "required": ["candidate_id", "expectations"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "expectations": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectationEvaluation" }
        },
        "expectation_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      },
      "additionalProperties": false
    },
    "candidateScore": {
      "type": "object",
      "required": [
        "candidate_id",
        "expectation_score",
        "critical_violation_count",
        "unverified_count",
        "evidence_warning_count",
        "recommendable"
      ],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "expectation_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "critical_violation_count": { "type": "integer", "minimum": 0 },
        "unverified_count": { "type": "integer", "minimum": 0 },
        "evidence_warning_count": { "type": "integer", "minimum": 0 },
        "recommendable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "evaluationResultItem": {
      "type": "object",
      "required": [
        "candidate_id",
        "expectation_id",
        "probability",
        "confidence",
        "evidence_refs",
        "evidence_quality",
        "requires_validation"
      ],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "expectation_id": { "type": "string", "minLength": 1 },
        "probability": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "evidence_refs": { "$ref": "#/$defs/stringList" },
        "evidence_quality": {
          "type": "string",
          "enum": ["provided", "assumption", "human-review", "user-test", "runtime-log"]
        },
        "requires_validation": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "violation": {
      "type": "object",
      "required": ["candidate_id", "expectation_id", "severity", "description", "user_impact", "recommendation"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "expectation_id": { "type": "string", "minLength": 1 },
        "severity": {
          "type": "string",
          "enum": ["critical", "major", "minor", "positive-surprise", "ambiguous", "unverified"]
        },
        "description": { "type": "string" },
        "user_impact": { "type": "string" },
        "recommendation": { "type": "string" }
      },
      "additionalProperties": false
    },
    "violationSummary": {
      "type": "object",
      "required": [
        "candidate_id",
        "critical",
        "major",
        "minor",
        "ambiguous",
        "unverified",
        "positive_surprise"
      ],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "critical": { "type": "integer", "minimum": 0 },
        "major": { "type": "integer", "minimum": 0 },
        "minor": { "type": "integer", "minimum": 0 },
        "ambiguous": { "type": "integer", "minimum": 0 },
        "unverified": { "type": "integer", "minimum": 0 },
        "positive_surprise": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "tradeOff": {
      "type": "object",
      "required": [
        "candidate_id",
        "gained_values",
        "lost_values",
        "affected_expectations",
        "implementation_impact",
        "future_impact",
        "human_decision_required",
        "evidence_refs"
      ],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "gained_values": { "$ref": "#/$defs/stringList" },
        "lost_values": { "$ref": "#/$defs/stringList" },
        "affected_expectations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "implementation_impact": { "type": "string" },
        "future_impact": { "type": "string" },
        "human_decision_required": { "$ref": "#/$defs/stringList" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  }
}
