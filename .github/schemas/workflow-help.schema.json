{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Help Registry",
  "type": "object",
  "required": ["registry_version", "commands"],
  "properties": {
    "registry_version": { "type": "string" },
    "description": { "type": "string" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "command", "workflow", "skill", "overview", "prerequisites", "arguments", "details", "examples"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "command": { "type": "string", "pattern": "^/[A-Za-z0-9_.-]+$" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "workflow": { "type": "string" },
          "skill": { "type": "string" },
          "skill_path": { "type": "string" },
          "prompt_path": { "type": "string" },
          "overview": { "type": "string" },
          "prerequisites": { "type": "array", "items": { "type": "string" } },
          "arguments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "required", "description"],
              "properties": {
                "name": { "type": "string" },
                "required": { "type": "boolean" },
                "description": { "type": "string" },
                "examples": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": false
            }
          },
          "details": { "type": "array", "items": { "type": "string" } },
          "examples": { "type": "array", "items": { "type": "string" } },
          "related_runtime": { "type": "array", "items": { "type": "string" } },
          "docs": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "standalone_command",
          "overview",
          "prerequisites",
          "trigger",
          "input_directory",
          "prefixes",
          "parent_workflows",
          "details",
          "examples"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "standalone_command": { "type": "boolean" },
          "overview": { "type": "string" },
          "prerequisites": { "type": "array", "items": { "type": "string" } },
          "trigger": { "type": "string" },
          "input_directory": { "type": "string" },
          "output": { "type": "string" },
          "prefixes": { "type": "array", "items": { "type": "string" } },
          "parent_workflows": { "type": "array", "items": { "type": "string" } },
          "details": { "type": "array", "items": { "type": "string" } },
          "examples": { "type": "array", "items": { "type": "string" } },
          "related_runtime": { "type": "array", "items": { "type": "string" } },
          "docs": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
