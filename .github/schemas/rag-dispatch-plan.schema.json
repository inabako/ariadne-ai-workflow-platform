{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAG Dispatch Plan",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "plan_id",
    "created_at",
    "queries"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "examples": ["1.0"]
    },
    "artifact_type": {
      "const": "rag-dispatch-plan"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "workflow": {
      "type": "string"
    },
    "work_id": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "planning_method": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "project": { "type": "string" },
        "repository": { "type": "string" },
        "branch": { "type": "string" },
        "source_type": { "type": "string" },
        "category": { "type": "string" },
        "trust_level": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "semantic_hints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "query",
          "purpose"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string"
          },
          "search_mode": {
            "type": "string",
            "enum": ["keyword", "semantic", "hybrid"]
          },
          "filters": {
            "type": "object",
            "properties": {
              "project": { "type": "string" },
              "repository": { "type": "string" },
              "branch": { "type": "string" },
              "source_type": { "type": "string" },
              "category": { "type": "string" },
              "trust_level": { "type": "string" },
              "tags": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
