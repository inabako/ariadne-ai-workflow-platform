environment          = "dev"
service_name         = "realtime-gateway"
service_image        = "example/realtime-gateway:replace-me"
service_host         = "replace-me"
runtime_type         = "docker"
health_port          = 8080
metrics_port         = 9090
inbound_tcp_ports    = [8080]
inbound_udp_ports    = []
allowed_client_cidrs = ["10.0.0.0/8"]
allowed_device_cidrs = ["10.0.0.0/8"]
allowed_admin_cidrs  = ["10.0.0.0/8"]
enable_metrics       = true
enable_dns           = false
gateway_domain       = null
enable_alert         = false
alert_webhook_url    = null
