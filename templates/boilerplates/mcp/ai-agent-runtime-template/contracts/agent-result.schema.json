{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariadne.local/contracts/agent-runtime/agent-result.schema.json",
  "title": "AgentResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "workflow_id", "trace_id", "status", "output", "evidence", "error"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string", "minLength": 1 },
    "workflow_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
    "status": { "type": "string", "enum": ["completed", "failed", "waiting_human"] },
    "output": { "type": "object" },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "error": { "type": ["object", "null"] }
  }
}
