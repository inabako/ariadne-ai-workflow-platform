{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariadne.local/contracts/agent-runtime/human-check.schema.json",
  "title": "HumanCheckRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "trace_id", "workflow_id", "step", "reason", "status", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "request_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
    "workflow_id": { "type": "string", "minLength": 1 },
    "step": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
