{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariadne.local/contracts/agent-runtime/runtime-error.schema.json",
  "title": "RuntimeError",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "error_id", "trace_id", "workflow_id", "code", "message", "retryable", "framework_metadata"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "error_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
    "workflow_id": { "type": "string", "minLength": 1 },
    "code": { "type": "string", "minLength": 1 },
    "message": { "type": "string", "minLength": 1 },
    "retryable": { "type": "boolean" },
    "framework_metadata": { "type": "object" }
  }
}
