{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariadne.local/contracts/agent-runtime/agent-task.schema.json",
  "title": "AgentTask",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "workflow_id", "trace_id", "agent_id", "instructions", "context"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string", "minLength": 1 },
    "workflow_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
    "agent_id": { "type": "string", "minLength": 1 },
    "instructions": { "type": "string", "minLength": 1 },
    "context": { "type": "object" }
  }
}
