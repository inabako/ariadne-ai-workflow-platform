OPENLDAP_VERSION=1.5.0
LDAP_ORGANISATION=Example Organization
LDAP_DOMAIN=example.local
LDAP_BASE_DN=dc=example,dc=local
LDAP_ADMIN_PASSWORD=replace-with-secret-store-value
LDAP_CONFIG_PASSWORD=replace-with-secret-store-value
LDAP_APPLICATION_BIND_DN=cn=webapp-bind,ou=services,dc=example,dc=local
LDAP_APPLICATION_BIND_PASSWORD=replace-with-secret-store-value
LDAP_TLS=false
LDAP_BACKUP_RETENTION_DAYS=7

