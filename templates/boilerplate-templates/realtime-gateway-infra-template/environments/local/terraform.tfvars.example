service_name         = "realtime-gateway"
service_image        = "example/realtime-gateway:local"
service_host         = "localhost"
runtime_type         = "docker"
health_port          = 8080
metrics_port         = 9090
inbound_tcp_ports    = [8080]
inbound_udp_ports    = []
allowed_client_cidrs = ["127.0.0.1/32"]
allowed_device_cidrs = ["127.0.0.1/32"]
allowed_admin_cidrs  = ["127.0.0.1/32"]
enable_metrics       = true
enable_dns           = false
gateway_domain       = null
enable_alert         = false
alert_webhook_url    = null
