    {
      "label": "test:msys2-localty-smoke",
      "type": "shell",
      "command": "C:\\msys64\\usr\\bin\\bash.exe -lc \"python --version; gst-launch-1.0 --version\"",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "MSYSTEM": "MINGW64",
          "CHERE_INVOKING": "1"
        }
      },
