    },
    {
      "label": "test:go-version",
      "type": "shell",
      "command": "$env:Path = [Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [Environment]::GetEnvironmentVariable('Path','User') + ';' + $env:Path; $go = (Get-Command go -ErrorAction SilentlyContinue).Source; if (-not $go -and (Test-Path 'C:\\Program Files\\Go\\bin\\go.exe')) { $go = 'C:\\Program Files\\Go\\bin\\go.exe' }; if (-not $go) { throw 'go executable was not found. Restart VSCode or install Go.' }; & $go version",
      "options": {
        "cwd": "${workspaceFolder}"
