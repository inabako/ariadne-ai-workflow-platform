# Local environment files
.env
.env.*
!.env.example
.codex/

# Local work workspace
# GitHubにはworkflow本体とwork構成説明READMEのみを上げる。
# 要件draft、SVG入力、issue作業、close archive実体は追跡しない。
work/**
!work/**/
!work/**/README.md

# Local RAG knowledge workspace
# GitHubにはworkflow本体とRAG構成説明READMEのみを上げる。
# RAG蓄積物・生成物は追跡しない。
rag/**
!rag/**/
!rag/**/README.md

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.coverage
coverage.xml
htmlcov/
runtime/.coverage_html/
runtime/.coverage.json
runtime/logs/
