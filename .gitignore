# Local environment files
.env
.env.*
!.env.example
.codex/

# Local work workspace
# GitHubにはworkflow本体とwork構成説明READMEのみを上げる。
# 要件draft、SVG入力、issue作業、close archive実体は追跡しない。
work/**
!work/**/
!work/**/README.md
work/db/**

# Local RAG knowledge workspace
# RAG source of truthは work/db/ariadne-knowledge-platform 側へ分離する。
# Ariadne本体側の rag/ はDuckDB、evidence、retrieval等のlocal生成workspaceとして追跡しない。
rag/**

# Generated database read models
db/rag/**
db/registries/registry.duckdb

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.coverage
coverage.xml
htmlcov/
runtime/.coverage_html/
runtime/.coverage.json
runtime/logs/
.gitignore
