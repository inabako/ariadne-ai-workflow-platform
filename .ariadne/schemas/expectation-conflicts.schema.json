{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Expectation Conflicts",
  "type": "object",
  "required": ["schema_version", "artifact_type", "conflicts"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "schema": { "type": "string" },
    "artifact_type": { "type": "string", "const": "expectation-conflicts" },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "expectation_a", "expectation_b", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "expectation_a": { "type": "string", "minLength": 1 },
          "expectation_b": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
