{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-shared-artifact-validation.schema.json",
  "title": "Workspace Shared Artifact Validation",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "workflow",
    "work_id",
    "created_at",
    "status",
    "missing_required_items",
    "conditions",
    "open_questions",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "artifact_type": {
      "const": "workspace-shared-artifact-validation"
    },
    "workflow": {
      "const": "vscode-environment"
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "status": {
      "enum": ["pass", "conditional-pass", "fail"]
    },
    "missing_required_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "result": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
