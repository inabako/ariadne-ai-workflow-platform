{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariadne.local/schemas/kubernetes-gap-report.schema.json",
  "title": "Kubernetes Gap Report",
  "type": "object",
  "required": ["schema_version", "artifact_type", "status", "work_id", "gaps"],
  "properties": {
    "schema_version": {"type": "string"},
    "schema": {"type": "string"},
    "artifact_type": {"const": "kubernetes-gap-report"},
    "status": {"type": "string"},
    "work_id": {"type": "string"},
    "target": {"type": "string"},
    "assessment_path": {"type": "string"},
    "gaps": {"type": "array", "items": {"type": "object"}},
    "next_actions": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "object"}
  },
  "additionalProperties": true
}
