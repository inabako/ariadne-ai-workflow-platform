{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Expectation Set",
  "type": "object",
  "required": ["schema_version", "artifact_type", "expectations"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "schema": { "type": "string" },
    "artifact_type": { "type": "string", "const": "expectation-set" },
    "expectations": {
      "type": "array",
      "items": { "$ref": "#/$defs/expectation" }
    },
    "conflicts": {
      "type": "array",
      "items": { "$ref": "#/$defs/conflict" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "expectation": {
      "type": "object",
      "required": ["id", "statement", "confidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "expectation_id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "category": {
          "type": "string",
          "enum": [
            "Functional Expectation",
            "Interaction Expectation",
            "Visual Expectation",
            "Feedback Expectation",
            "Error Handling Expectation",
            "Accessibility Expectation",
            "Emotional Expectation",
            "Product Identity Expectation",
            "Performance Expectation",
            "Privacy Expectation"
          ]
        },
        "success_condition": { "$ref": "#/$defs/stringList" },
        "success_conditions": { "$ref": "#/$defs/stringList" },
        "failure_condition": { "$ref": "#/$defs/stringList" },
        "failure_conditions": { "$ref": "#/$defs/stringList" },
        "source": { "$ref": "#/$defs/stringList" },
        "sources": { "$ref": "#/$defs/stringList" },
        "evidence_refs": { "$ref": "#/$defs/stringList" },
        "target_user": { "type": "string" },
        "usage_context": { "type": "string" },
        "rationale": { "$ref": "#/$defs/stringList" },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      },
      "anyOf": [{ "required": ["success_condition"] }, { "required": ["success_conditions"] }],
      "additionalProperties": false
    },
    "conflict": {
      "type": "object",
      "required": ["id", "expectation_a", "expectation_b", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "expectation_a": { "type": "string", "minLength": 1 },
        "expectation_b": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
