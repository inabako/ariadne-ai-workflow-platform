{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trade-off Analysis",
  "type": "object",
  "required": ["schema_version", "artifact_type", "tradeoffs"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "schema": { "type": "string" },
    "artifact_type": {
      "type": "string",
      "enum": ["trade-off-analysis"]
    },
    "tradeoffs": {
      "type": "array",
      "items": { "$ref": "#/$defs/tradeOff" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "tradeOff": {
      "type": "object",
      "required": [
        "candidate_id",
        "gained_values",
        "lost_values",
        "affected_expectations",
        "implementation_impact",
        "future_impact",
        "human_decision_required",
        "evidence_refs"
      ],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "gained_values": { "$ref": "#/$defs/stringList" },
        "lost_values": { "$ref": "#/$defs/stringList" },
        "affected_expectations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "implementation_impact": { "type": "string" },
        "future_impact": { "type": "string" },
        "human_decision_required": { "$ref": "#/$defs/stringList" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  }
}
