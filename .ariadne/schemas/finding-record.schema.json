{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finding Record",
  "type": "object",
  "required": [
    "id",
    "severity",
    "area",
    "finding",
    "risk",
    "recommendation",
    "owner_agent"
  ],
  "properties": {
    "id": {
      "type": "string",
      "examples": ["FND-001"]
    },
    "owner_agent": { "type": "string" },
    "source_artifact": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "area": {
      "type": "string",
      "enum": [
        "safety",
        "security",
        "network",
        "runtime",
        "control",
        "video",
        "telemetry",
        "deployment",
        "observability",
        "operation",
        "documentation",
        "other"
      ]
    },
    "finding": { "type": "string" },
    "risk": { "type": "string" },
    "recommendation": { "type": "string" },
    "required_action": { "type": "string" },
    "required_tests": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blocking": { "type": "boolean" },
    "status": {
      "type": "string",
      "enum": ["open", "accepted-risk", "fixed", "verified", "closed"]
    },
    "related_qa": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

