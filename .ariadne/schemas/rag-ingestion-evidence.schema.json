{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAG Ingestion Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "artifact_type": {
      "type": "string",
      "enum": [
        "rag-ingestion-source-manifest",
        "rag-ingestion-evaluation",
        "rag-ingestion-summary"
      ]
    },
    "created_at": { "type": "string" },
    "evaluated_at": { "type": "string" },
    "candidate_chunk_id": { "type": "string" },
    "document_id": { "type": "string" },
    "source_path": { "type": "string" },
    "decision": {
      "type": "string",
      "enum": ["ACCEPT", "REWRITE", "HUMAN_CHECK", "REJECT"]
    },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "scores": { "type": "object" },
    "reasons": { "type": "object" },
    "original_content_hash": { "type": "string" },
    "optimized_content_hash": { "type": "string" },
    "candidate_chunk_count": { "type": "integer", "minimum": 0 },
    "accepted_chunk_count": { "type": "integer", "minimum": 0 },
    "rewritten_chunk_count": { "type": "integer", "minimum": 0 },
    "human_check_required_count": { "type": "integer", "minimum": 0 },
    "rejected_chunk_count": { "type": "integer", "minimum": 0 },
    "average_optimization_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "embedding_allowed_chunk_count": { "type": "integer", "minimum": 0 },
    "human_check_required": { "type": "boolean" }
  },
  "additionalProperties": true
}
