{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human Gate Registry File Schema",
  "type": "object",
  "required": [
    "registry_version",
    "gates"
  ],
  "properties": {
    "registry_version": {
      "const": "1.0"
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "requires_human_check",
          "approved_value",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "requires_human_check": {
            "type": "boolean"
          },
          "approved_value": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
