{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariadne.local/schemas/workflow-doctor-warning.schema.json",
  "title": "Workflow Doctor Warning",
  "type": "object",
  "required": [
    "id",
    "message",
    "severity",
    "category",
    "repairable",
    "human_review_required",
    "next_action",
    "repair_command",
    "ignore_condition",
    "paths"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"]
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "repairable": {
      "type": "boolean"
    },
    "human_review_required": {
      "type": "boolean"
    },
    "cause": {
      "type": "string"
    },
    "impact": {
      "type": "string"
    },
    "next_action": {
      "type": "string"
    },
    "repair_command": {
      "type": "string"
    },
    "ignore_condition": {
      "type": "string"
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
