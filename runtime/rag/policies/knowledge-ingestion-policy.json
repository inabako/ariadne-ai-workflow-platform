{
  "schema_version": "1.0",
  "weights": {
    "semantic_completeness": 0.18,
    "retrieval_usefulness": 0.15,
    "source_reliability": 0.14,
    "metadata_completeness": 0.10,
    "context_independence": 0.12,
    "traceability": 0.10,
    "noise_penalty": 0.06,
    "duplication_penalty": 0.05,
    "ambiguity_penalty": 0.04,
    "oversize_penalty": 0.02,
    "fragmentation_penalty": 0.02,
    "conflict_penalty": 0.02
  },
  "thresholds": {
    "accept": 0.80,
    "rewrite": 0.55
  },
  "human_check_topics": [
    "governance",
    "platform governance",
    "human responsibility",
    "security",
    "runtime core",
    "workflow core",
    "encoding",
    "utf-8",
    "互換性",
    "正式仕様",
    "矛盾"
  ],
  "reject_patterns": [
    "password\\s*[:=]",
    "token\\s*[:=]",
    "api[_-]?key\\s*[:=]",
    "private key",
    "credential",
    "secret\\s*[:=]"
  ],
  "noise_patterns": [
    "^\\s*目次\\s*$",
    "^\\s*todo\\s*$",
    "^\\s*tbd\\s*$",
    "未入力",
    "ここに.*記載",
    "placeholder",
    "lorem ipsum"
  ],
  "ambiguous_terms": [
    "上記",
    "前述",
    "以下",
    "これ",
    "それ",
    "あれ",
    "適宜",
    "いい感じ",
    "必要に応じて"
  ]
}
